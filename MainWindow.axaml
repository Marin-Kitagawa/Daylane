<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="using:Daylane.ViewModels"
        xmlns:models="using:Daylane.Models"
        xmlns:controls="using:Daylane.Controls"
        xmlns:conv="using:Daylane.Converters"
        mc:Ignorable="d"
        d:DesignWidth="1400"
        d:DesignHeight="860"
        x:Class="Daylane.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Icon="/Assets/app-icon.ico"
        Title="Daylane"
        Width="1400"
        Height="860"
        MinWidth="1100"
        MinHeight="680"
        WindowState="Maximized"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <conv:StringEqualsConverter x:Key="StringEqualsConverter" />
        <conv:IgnoreRuleDisplayConverter x:Key="IgnoreRuleDisplayConverter" />
    </Window.Resources>

    <Grid RowDefinitions="72,*">
        <Border Background="{DynamicResource AppSurfaceBrush}"
                BorderBrush="{DynamicResource AppBorderBrush}"
                BorderThickness="0,0,0,1"
                Padding="16,0">
            <Grid ColumnDefinitions="Auto,*,Auto">
                <StackPanel Orientation="Horizontal" Spacing="20" VerticalAlignment="Center">
                    <TextBlock Text="Daylane"
                               Classes="brand"
                               VerticalAlignment="Center" />

                    <Border x:Name="TabSegmentGroup" VerticalAlignment="Center">
                        <Panel>
                            <Border x:Name="TabThumb"
                                    Classes="tab-thumb"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Top"
                                    IsHitTestVisible="False" />
                            <StackPanel Orientation="Horizontal" Spacing="0">
                                <Button x:Name="DayTabButton"
                                        Classes="tab"
                                        Content="Day"
                                        Command="{Binding SelectDayCommand}"
                                        Classes.active="{Binding IsDaySelected}" />
                                <Button x:Name="InsightsTabButton"
                                        Classes="tab"
                                        Content="Insights"
                                        Command="{Binding SelectInsightsCommand}"
                                        Classes.active="{Binding IsInsightsSelected}" />
                                <Button x:Name="SettingsTabButton"
                                        Classes="tab"
                                        Content="Settings"
                                        Command="{Binding SelectSettingsCommand}"
                                        Classes.active="{Binding IsSettingsSelected}" />
                            </StackPanel>
                        </Panel>
                    </Border>

                    <StackPanel Orientation="Horizontal"
                                Spacing="6"
                                VerticalAlignment="Center"
                                IsVisible="{Binding IsDaySelected}">
                        <Button x:Name="DayPickerButton"
                                Classes="date-picker"
                                VerticalAlignment="Center">
                            <Button.Flyout>
                                <Flyout Placement="BottomEdgeAlignedLeft">
                                    <Calendar SelectedDate="{Binding SelectedDay, Mode=TwoWay}"
                                              SelectedDatesChanged="OnDayCalendarSelectedDatesChanged" />
                                </Flyout>
                            </Button.Flyout>
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <Path Width="14"
                                      Height="14"
                                      Stretch="Uniform"
                                      VerticalAlignment="Center"
                                      Fill="{DynamicResource AppMutedBrush}"
                                      Data="M4,2 V4 H2.5 A1.5,1.5,0,0,0,1,5.5 V13.5 A1.5,1.5,0,0,0,2.5,15 H13.5 A1.5,1.5,0,0,0,15,13.5 V5.5 A1.5,1.5,0,0,0,13.5,4 H12 V2 H10.5 V4 H5.5 V2 Z M2.5,6.5 H13.5 V13.5 H2.5 Z" />
                                <TextBlock Text="{Binding DayLabel}"
                                           FontSize="13"
                                           FontWeight="Medium"
                                           VerticalAlignment="Center"
                                           MinWidth="120" />
                                <Path Width="10"
                                      Height="6"
                                      Stretch="Uniform"
                                      VerticalAlignment="Center"
                                      Fill="{DynamicResource AppMutedBrush}"
                                      Data="M1,1 L5,5 L9,1" />
                            </StackPanel>
                        </Button>
                        <Button Classes="date-nav"
                                Command="{Binding PreviousDayCommand}"
                                ToolTip.Tip="Previous day"
                                Content="‹" />
                        <Button Classes="date-nav"
                                Command="{Binding NextDayCommand}"
                                IsEnabled="{Binding CanGoNextDay}"
                                ToolTip.Tip="Next day"
                                Content="›" />
                        <Button Classes="secondary"
                                Content="Today"
                                Command="{Binding SelectTodayCommand}"
                                IsVisible="{Binding !IsSelectedDayToday}"
                                MinHeight="34"
                                Padding="12,7" />
                        <TextBox x:Name="SearchBox"
                                 Classes="search-box"
                                 Width="220"
                                 MinHeight="34"
                                 PlaceholderText="Search titles and hosts…"
                                 Text="{Binding SearchQuery, Mode=TwoWay}" />
                    </StackPanel>

                    <StackPanel Orientation="Horizontal"
                                Spacing="6"
                                VerticalAlignment="Center"
                                IsVisible="{Binding IsInsightsSelected}">
                        <Border x:Name="PeriodSegmentGroup" Classes="segment-group">
                            <Panel>
                                <Border x:Name="PeriodThumb"
                                        Classes="segment-thumb"
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Top"
                                        IsHitTestVisible="False" />
                                <StackPanel Orientation="Horizontal" Spacing="0">
                                    <Button x:Name="WeekPeriodButton"
                                            Classes="segment"
                                            Content="Week"
                                            Command="{Binding SelectWeekPeriodCommand}"
                                            Classes.active="{Binding IsWeekPeriod}" />
                                    <Button x:Name="MonthPeriodButton"
                                            Classes="segment"
                                            Content="Month"
                                            Command="{Binding SelectMonthPeriodCommand}"
                                            Classes.active="{Binding IsMonthPeriod}" />
                                </StackPanel>
                            </Panel>
                        </Border>
                        <Border Classes="date-picker"
                                Padding="12,7"
                                Margin="4,0,0,0"
                                VerticalAlignment="Center">
                            <TextBlock Text="{Binding PeriodLabel}"
                                       FontSize="13"
                                       FontWeight="Medium"
                                       VerticalAlignment="Center"
                                       MinWidth="168" />
                        </Border>
                        <Button Classes="date-nav"
                                Command="{Binding PreviousPeriodCommand}"
                                ToolTip.Tip="Previous period"
                                Content="‹" />
                        <Button Classes="date-nav"
                                Command="{Binding NextPeriodCommand}"
                                IsEnabled="{Binding CanGoNextPeriod}"
                                ToolTip.Tip="Next period"
                                Content="›" />
                        <Button Classes="secondary"
                                Content="Current"
                                Command="{Binding SelectCurrentPeriodCommand}"
                                IsVisible="{Binding CanGoNextPeriod}"
                                MinHeight="34"
                                Padding="12,7" />
                    </StackPanel>
                </StackPanel>

                <!-- Not nested inside the Spacing="20" StackPanel above: a Popup measures to
                     zero size but stays IsVisible=true while closed, so as a StackPanel child
                     it would still claim its share of that panel's inter-item Spacing. -->
                <Popup PlacementTarget="{Binding #SearchBox}"
                       Placement="BottomEdgeAlignedLeft"
                       IsOpen="{Binding ShowSearchPopup}"
                       IsLightDismissEnabled="False"
                       Width="380">
                    <Border Classes="panel" Padding="0" MaxHeight="360">
                        <Grid RowDefinitions="36,*">
                            <Border BorderBrush="{DynamicResource AppBorderBrush}"
                                    BorderThickness="0,0,0,1"
                                    Padding="14,0"
                                    Background="{DynamicResource AppSurfaceAltBrush}">
                                <TextBlock Text="Search results"
                                           FontSize="12"
                                           FontWeight="SemiBold"
                                           VerticalAlignment="Center" />
                            </Border>
                            <ScrollViewer Grid.Row="1"
                                          MaxHeight="320"
                                          VerticalScrollBarVisibility="Auto"
                                          IsVisible="{Binding HasSearchResults}">
                                <ListBox Classes="plain-list"
                                         ItemsSource="{Binding SearchResults}"
                                         SelectedItem="{Binding SelectedSearchItem, Mode=TwoWay}">
                                    <ListBox.Styles>
                                        <!-- A header row is a labeled divider, not a result:
                                             selecting one would silently no-op (SelectedSearchItem's
                                             setter only reacts to a row with a SegmentId) while
                                             leaving it visibly highlighted. -->
                                        <Style Selector="ListBoxItem" x:DataType="vm:TitleSearchItemViewModel">
                                            <Setter Property="IsEnabled" Value="{Binding !IsHeader}" />
                                        </Style>
                                    </ListBox.Styles>
                                    <ListBox.ItemTemplate>
                                        <DataTemplate x:DataType="vm:TitleSearchItemViewModel">
                                            <Panel>
                                                <Border Padding="14,4,14,2" IsVisible="{Binding IsHeader}">
                                                    <TextBlock Text="{Binding AppDisplayName}"
                                                               Classes="muted"
                                                               FontSize="11"
                                                               FontWeight="SemiBold" />
                                                </Border>
                                                <Border Classes="app-row"
                                                        Padding="14,7"
                                                        BorderBrush="{DynamicResource AppBorderBrush}"
                                                        BorderThickness="0,0,0,1"
                                                        IsVisible="{Binding !IsHeader}">
                                                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                                                        <TextBlock Text="{Binding TimeText}"
                                                                   Classes="muted"
                                                                   FontSize="11"
                                                                   VerticalAlignment="Center" />
                                                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
                                                            <TextBlock Text="{Binding TitleText}"
                                                                       Classes="search-hit-title"
                                                                       Classes.excluded="{Binding IsExcluded}"
                                                                       FontSize="12"
                                                                       TextTrimming="CharacterEllipsis"
                                                                       VerticalAlignment="Center" />
                                                            <TextBlock Text="Excluded"
                                                                       Classes="muted"
                                                                       FontSize="10"
                                                                       IsVisible="{Binding IsExcluded}"
                                                                       VerticalAlignment="Center" />
                                                        </StackPanel>
                                                    </Grid>
                                                </Border>
                                            </Panel>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </ScrollViewer>
                            <StackPanel Grid.Row="1"
                                        Spacing="4"
                                        Margin="14"
                                        IsVisible="{Binding ShowSearchEmptyState}">
                                <TextBlock Classes="empty-title" Text="No matches" />
                                <TextBlock Classes="empty-body" Text="No captured titles or hosts match that search for this day." />
                            </StackPanel>
                        </Grid>
                    </Border>
                </Popup>

                <StackPanel Grid.Column="2"
                            Orientation="Horizontal"
                            Spacing="10"
                            VerticalAlignment="Center">
                    <Border Classes="status-live" IsVisible="{Binding IsRunning}">
                        <StackPanel Orientation="Horizontal" Spacing="7">
                            <Ellipse Width="7" Height="7" Fill="{DynamicResource AppAccentBrush}" VerticalAlignment="Center" />
                            <TextBlock Text="Live"
                                       FontSize="12"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource AppAccentBrush}"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>
                    <Border Classes="status-idle" IsVisible="{Binding !IsRunning}">
                        <TextBlock Text="Stopped" FontSize="12" FontWeight="SemiBold" Classes="muted" />
                    </Border>
                    <Button Classes="date-nav"
                            ToolTip.Tip="More">
                        <Button.Flyout>
                            <MenuFlyout Placement="BottomEdgeAlignedRight">
                                <MenuItem Header="Open data folder"
                                          Command="{Binding OpenDataFolderCommand}" />
                            </MenuFlyout>
                        </Button.Flyout>
                        <TextBlock Text="···"
                                   FontSize="16"
                                   FontWeight="Bold"
                                   VerticalAlignment="Center"
                                   HorizontalAlignment="Center" />
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Day -->
        <Grid Grid.Row="1" IsVisible="{Binding IsDaySelected}" Margin="16" RowDefinitions="Auto,Auto,*" RowSpacing="12">
            <Border Classes="panel" Padding="0" MinHeight="230">
                <Grid>
                    <Grid ColumnDefinitions="148,*"
                          IsVisible="{Binding HasDayActivity}">
                            <Grid RowDefinitions="26,72,63,63">
                                <Border Background="{DynamicResource AppSurfaceAltBrush}"
                                        BorderBrush="{DynamicResource AppBorderBrush}"
                                        BorderThickness="0,0,1,1" />
                                <Border Grid.Row="1"
                                        Background="{DynamicResource AppSurfaceAltBrush}"
                                        BorderBrush="{DynamicResource AppBorderBrush}"
                                        BorderThickness="0,0,1,1"
                                        Padding="16,0">
                                    <TextBlock Text="Applications" FontSize="12" FontWeight="Medium" VerticalAlignment="Center" />
                                </Border>
                                <Border Grid.Row="2"
                                        Background="{DynamicResource AppSurfaceAltBrush}"
                                        BorderBrush="{DynamicResource AppBorderBrush}"
                                        BorderThickness="0,0,1,1"
                                        Padding="16,0">
                                    <StackPanel Spacing="4" VerticalAlignment="Center">
                                        <TextBlock Text="Active / Away" FontSize="12" FontWeight="Medium" />
                                        <StackPanel Orientation="Horizontal" Spacing="10">
                                            <StackPanel Orientation="Horizontal" Spacing="4">
                                                <Border Classes="legend-swatch" Background="{DynamicResource AppAccentBrush}" />
                                                <TextBlock Classes="legend-label" Text="Active" />
                                            </StackPanel>
                                            <StackPanel Orientation="Horizontal" Spacing="4">
                                                <controls:AwayFill Width="8" Height="8" CornerRadius="2" />
                                                <TextBlock Classes="legend-label" Text="Away" />
                                            </StackPanel>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                                <Border Grid.Row="3"
                                        Background="{DynamicResource AppSurfaceAltBrush}"
                                        BorderBrush="{DynamicResource AppBorderBrush}"
                                        BorderThickness="0,0,1,0"
                                        Padding="16,0">
                                    <StackPanel Spacing="4" VerticalAlignment="Center"
                                                ToolTip.Tip="Keys and clicks per minute while Active">
                                        <TextBlock Text="Input" FontSize="12" FontWeight="Medium" />
                                        <StackPanel Orientation="Horizontal" Spacing="4">
                                            <Border Classes="legend-swatch" Background="{DynamicResource AppIntensity1Brush}" />
                                            <Border Classes="legend-swatch" Background="{DynamicResource AppIntensity2Brush}" />
                                            <Border Classes="legend-swatch" Background="{DynamicResource AppIntensity3Brush}" />
                                            <TextBlock Classes="legend-label" Margin="2,0,0,0" Text="Light → heavy" />
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <ScrollViewer x:Name="TimelineScroll"
                                          Grid.Column="1"
                                          HorizontalScrollBarVisibility="Auto"
                                          VerticalScrollBarVisibility="Disabled"
                                          Focusable="True">
                                <controls:TimelineZoomSurface x:Name="TimelineZoomSurface"
                                                              Zoom="{Binding TimelineZoom}">
                                    <Grid RowDefinitions="26,72,63,63" Background="{DynamicResource AppSurfaceBrush}">
                                        <Border Background="{DynamicResource AppSurfaceAltBrush}"
                                                BorderBrush="{DynamicResource AppBorderBrush}"
                                                BorderThickness="0,0,0,1">
                                            <controls:TimelineRuler Height="26" />
                                        </Border>
                                        <Border Grid.Row="1"
                                                BorderBrush="{DynamicResource AppBorderBrush}"
                                                BorderThickness="0,0,0,1"
                                                Height="72">
                                            <controls:TimelineLane Height="72"
                                                                   Mode="Applications"
                                                                   Segments="{Binding TimelineSegments}"
                                                                   DayStartLocal="{Binding SelectedDay}"
                                                                   SelectedSegmentId="{Binding SelectedSegmentId, Mode=TwoWay}" />
                                        </Border>
                                        <Border Grid.Row="2"
                                                BorderBrush="{DynamicResource AppBorderBrush}"
                                                BorderThickness="0,0,0,1"
                                                Height="63">
                                            <controls:TimelineLane Height="63"
                                                                   Mode="Computer"
                                                                   Segments="{Binding TimelineSegments}"
                                                                   DayStartLocal="{Binding SelectedDay}"
                                                                   SelectedSegmentId="{Binding SelectedSegmentId, Mode=TwoWay}" />
                                        </Border>
                                        <Border Grid.Row="3" Height="63">
                                            <controls:TimelineLane Height="63"
                                                                   Mode="Activity"
                                                                   Segments="{Binding TimelineSegments}"
                                                                   DayStartLocal="{Binding SelectedDay}"
                                                                   SelectedSegmentId="{Binding SelectedSegmentId, Mode=TwoWay}" />
                                        </Border>
                                    </Grid>
                                </controls:TimelineZoomSurface>
                            </ScrollViewer>
                    </Grid>

                    <StackPanel Spacing="6"
                                Margin="24"
                                VerticalAlignment="Center"
                                HorizontalAlignment="Center"
                                IsVisible="{Binding !HasDayActivity}">
                        <TextBlock Classes="empty-title" Text="No tracked activity" />
                        <TextBlock Classes="empty-body" Text="Nothing was recorded for this day yet." />
                    </StackPanel>
                </Grid>
            </Border>

            <Grid Grid.Row="1" ColumnDefinitions="*,12,*">
                <Border Classes="panel" Padding="18" MinHeight="112">
                    <Grid>
                        <StackPanel Spacing="12" IsVisible="{Binding HasSelectedSegment}">
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Text="Selection" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" />
                                <Button Grid.Column="1"
                                        Classes="secondary"
                                        Content="Clear"
                                        Padding="10,4"
                                        MinHeight="28"
                                        FontSize="12"
                                        Command="{Binding ClearSelectionCommand}" />
                            </Grid>
                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                                <Panel Width="28" Height="28" VerticalAlignment="Top">
                                    <controls:AwayFill Width="28" Height="28" CornerRadius="4"
                                                       IsVisible="{Binding SelectedDetailIsAway}" />
                                    <Panel IsVisible="{Binding !SelectedDetailIsAway}">
                                        <Border Width="28" Height="28" CornerRadius="4"
                                                Background="{Binding SelectedDetailColor}"
                                                IsVisible="{Binding !HasSelectedDetailIcon}" />
                                        <Image Width="28" Height="28"
                                               Source="{Binding SelectedDetailIcon}"
                                               IsVisible="{Binding HasSelectedDetailIcon}" />
                                    </Panel>
                                </Panel>
                                <StackPanel Grid.Column="1" Spacing="4">
                                    <TextBlock Text="{Binding SelectedDetailTitle}"
                                               FontSize="16"
                                               FontWeight="SemiBold"
                                               TextTrimming="CharacterEllipsis" />
                                    <TextBlock Classes="muted"
                                               FontSize="12"
                                               Text="{Binding SelectedDetailRangeText}" />
                                    <StackPanel Orientation="Horizontal" Spacing="14">
                                        <TextBlock FontSize="12" FontWeight="SemiBold"
                                                   Text="{Binding SelectedDetailDurationText}" />
                                        <TextBlock Classes="muted" FontSize="12"
                                                   Text="{Binding SelectedDetailShareText}" />
                                        <TextBlock Classes="muted" FontSize="12"
                                                   IsVisible="{Binding !SelectedDetailIsAway}"
                                                   Text="{Binding SelectedDetailKeysText, StringFormat='Keys {0}'}" />
                                        <TextBlock Classes="muted" FontSize="12"
                                                   IsVisible="{Binding !SelectedDetailIsAway}"
                                                   Text="{Binding SelectedDetailClicksText, StringFormat='Clicks {0}'}" />
                                    </StackPanel>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                        <StackPanel Spacing="10" IsVisible="{Binding HasSelectedApp}">
                            <Grid ColumnDefinitions="*,Auto">
                                <StackPanel Spacing="2">
                                    <TextBlock Text="{Binding SelectedAppDisplayName}"
                                               FontSize="16"
                                               FontWeight="SemiBold"
                                               TextTrimming="CharacterEllipsis" />
                                    <TextBlock Classes="muted"
                                               FontSize="12"
                                               IsVisible="{Binding HasSelectedAppTitles}"
                                               Text="{Binding SelectedAppTotalText, StringFormat='Total {0}'}"
                                               ToolTip.Tip="Excludes rows marked Excluded" />
                                </StackPanel>
                                <Button Grid.Column="1"
                                        Classes="secondary"
                                        Content="Clear"
                                        Padding="10,4"
                                        MinHeight="28"
                                        FontSize="12"
                                        Command="{Binding ClearSelectionCommand}" />
                            </Grid>
                            <ScrollViewer MaxHeight="150"
                                          VerticalScrollBarVisibility="Auto"
                                          IsVisible="{Binding HasSelectedAppTitles}">
                                <ItemsControl ItemsSource="{Binding SelectedAppTitles}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:TitleUsageItemViewModel">
                                            <Border Classes="title-usage-row"
                                                    Classes.header="{Binding IsHeader}"
                                                    Classes.nested="{Binding IsNested}"
                                                    Classes.excluded="{Binding IsExcluded}">
                                                <Grid ColumnDefinitions="*,60,40" ColumnSpacing="8">
                                                    <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding DisplayText}"
                                                                   Classes="title-usage-text"
                                                                   Classes.header="{Binding IsHeader}"
                                                                   FontSize="12"
                                                                   TextTrimming="CharacterEllipsis" />
                                                        <TextBlock Text="Excluded"
                                                                   Classes="muted"
                                                                   FontSize="10"
                                                                   IsVisible="{Binding IsExcluded}" />
                                                    </StackPanel>
                                                    <TextBlock Grid.Column="1"
                                                               Text="{Binding DurationText}"
                                                               Classes="muted"
                                                               FontSize="11"
                                                               HorizontalAlignment="Right"
                                                               VerticalAlignment="Center" />
                                                    <TextBlock Grid.Column="2"
                                                               Text="{Binding SessionCountText}"
                                                               Classes="muted"
                                                               FontSize="11"
                                                               HorizontalAlignment="Right"
                                                               VerticalAlignment="Center"
                                                               IsVisible="{Binding !IsHeader}" />
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                            <StackPanel Spacing="4" IsVisible="{Binding ShowNoTitlesForSelectedApp}">
                                <TextBlock Classes="empty-title" Text="No titles captured" HorizontalAlignment="Left" />
                                <TextBlock Classes="empty-body"
                                           HorizontalAlignment="Left"
                                           TextAlignment="Left"
                                           Text="Window titles may be turned off for this app. Turn on title capture in Settings to see a breakdown here." />
                            </StackPanel>
                            <StackPanel Spacing="4" IsVisible="{Binding ShowNoDetailForSelectedApp}">
                                <TextBlock Classes="empty-title" Text="Details unavailable" HorizontalAlignment="Left" />
                                <TextBlock Classes="empty-body"
                                           HorizontalAlignment="Left"
                                           TextAlignment="Left"
                                           Text="Daylane cannot read this app's windows, so it has no breakdown to show. Elevated or protected apps are the usual reason." />
                            </StackPanel>
                        </StackPanel>
                        <StackPanel Spacing="6"
                                    VerticalAlignment="Center"
                                    HorizontalAlignment="Center"
                                    IsVisible="{Binding ShowSelectionEmptyState}">
                            <TextBlock Classes="empty-title" Text="No selection" />
                            <TextBlock Classes="empty-body" Text="Click a timeline block or activity row to inspect it." />
                        </StackPanel>
                    </Grid>
                </Border>

                <Border Grid.Column="2" Classes="panel" Padding="18" MinHeight="112">
                    <StackPanel Spacing="12">
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Text="Focus" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1" Classes="muted" FontSize="12"
                                       VerticalAlignment="Center"
                                       Text="{Binding PeakHourText}" />
                        </Grid>
                        <Grid ColumnDefinitions="*,*,*" ColumnSpacing="16">
                            <StackPanel Spacing="4">
                                <TextBlock Classes="muted" FontSize="11" Text="Longest Active" />
                                <TextBlock FontSize="18" FontWeight="Bold" Text="{Binding FocusLongestText}" />
                                <TextBlock Classes="muted" FontSize="11" Text="{Binding FocusLongestDetailText}"
                                           TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Spacing="4">
                                <TextBlock Classes="muted" FontSize="11" Text="App sessions" />
                                <TextBlock FontSize="18" FontWeight="Bold" Text="{Binding FocusSessionCountText}" />
                                <TextBlock Classes="muted" FontSize="11" Text="Foreground stretches" />
                            </StackPanel>
                            <StackPanel Grid.Column="2" Spacing="4">
                                <TextBlock Classes="muted" FontSize="11" Text="Away spans" />
                                <TextBlock FontSize="18" FontWeight="Bold" Text="{Binding FocusAwayCountText}" />
                                <TextBlock Classes="muted" FontSize="11" Text="Idle interruptions" />
                            </StackPanel>
                        </Grid>
                        <TextBlock Classes="muted"
                                   FontSize="12"
                                   Text="{Binding FocusLastAwayText}" />
                    </StackPanel>
                </Border>
            </Grid>

            <Grid Grid.Row="2" ColumnDefinitions="0.9*,12,1.25*,12,0.55*" ColumnSpacing="0">
                <Border Classes="panel" Padding="0">
                    <Grid RowDefinitions="40,*">
                        <Border BorderBrush="{DynamicResource AppBorderBrush}"
                                BorderThickness="0,0,0,1"
                                Padding="16,0"
                                Background="{DynamicResource AppSurfaceAltBrush}">
                            <Grid ColumnDefinitions="*,90,90,80">
                                <TextBlock Text="Activity" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1" Classes="muted" FontSize="11" FontWeight="SemiBold"
                                           Text="Start" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="2" Classes="muted" FontSize="11" FontWeight="SemiBold"
                                           Text="End" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="3" Classes="muted" FontSize="11" FontWeight="SemiBold"
                                           Text="Duration" HorizontalAlignment="Right" VerticalAlignment="Center" />
                            </Grid>
                        </Border>
                        <Panel Grid.Row="1">
                            <ListBox x:Name="SegmentList"
                                     Classes="plain-list"
                                     ItemsSource="{Binding SegmentItems}"
                                     SelectedItem="{Binding SelectedSegmentItem}"
                                     SelectionChanged="OnSegmentSelectionChanged"
                                     IsVisible="{Binding HasSegments}"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                     ScrollViewer.VerticalScrollBarVisibility="Auto">
                                <ListBox.ItemTemplate>
                                    <DataTemplate x:DataType="vm:ActivitySegmentItemViewModel">
                                        <Border Classes="app-row"
                                                Padding="12,8"
                                                BorderBrush="{DynamicResource AppBorderBrush}"
                                                BorderThickness="0,0,0,1">
                                            <Grid ColumnDefinitions="*,90,90,80">
                                                <StackPanel Orientation="Horizontal" Spacing="8">
                                                    <Panel Width="16" Height="16" VerticalAlignment="Center">
                                                        <controls:AwayFill Width="16" Height="16" CornerRadius="2"
                                                                           IsVisible="{Binding IsIdle}" />
                                                        <Panel IsVisible="{Binding !IsIdle}">
                                                            <Border Width="16" Height="16" CornerRadius="2"
                                                                    Background="{Binding Color}"
                                                                    IsVisible="{Binding !HasIcon}" />
                                                            <Image Width="16" Height="16"
                                                                   Source="{Binding Icon}"
                                                                   IsVisible="{Binding HasIcon}" />
                                                        </Panel>
                                                    </Panel>
                                                    <TextBlock Text="{Binding DisplayName}"
                                                               FontSize="13"
                                                               TextTrimming="CharacterEllipsis"
                                                               VerticalAlignment="Center" />
                                                </StackPanel>
                                                <TextBlock Grid.Column="1" Text="{Binding StartText}" Classes="muted"
                                                           FontSize="12" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                                <TextBlock Grid.Column="2" Text="{Binding EndText}" Classes="muted"
                                                           FontSize="12" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                                <TextBlock Grid.Column="3" Text="{Binding DurationText}"
                                                           FontSize="12"
                                                           HorizontalAlignment="Right"
                                                           VerticalAlignment="Center" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                            <StackPanel Spacing="6"
                                        VerticalAlignment="Center"
                                        HorizontalAlignment="Center"
                                        IsVisible="{Binding !HasSegments}">
                                <TextBlock Classes="empty-title" Text="No sessions" />
                                <TextBlock Classes="empty-body" Text="App switches and Away spans will show up here." />
                            </StackPanel>
                        </Panel>
                    </Grid>
                </Border>

                <Border Grid.Column="2" Classes="panel" Padding="0">
                    <Grid RowDefinitions="40,*,45">
                        <Border BorderBrush="{DynamicResource AppBorderBrush}"
                                BorderThickness="0,0,0,1"
                                Padding="16,0"
                                Background="{DynamicResource AppSurfaceAltBrush}">
                            <Grid ColumnDefinitions="*,140,76,60,60" ColumnSpacing="18">
                                <TextBlock Text="Apps" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1" Classes="muted" FontSize="11" FontWeight="SemiBold"
                                           Text="Share" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="2" Classes="muted" FontSize="11" FontWeight="SemiBold"
                                           Text="Duration" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="3" Classes="muted" FontSize="11" FontWeight="SemiBold"
                                           Text="Keys" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="4" Classes="muted" FontSize="11" FontWeight="SemiBold"
                                           Text="Clicks" HorizontalAlignment="Right" VerticalAlignment="Center" />
                            </Grid>
                        </Border>
                        <Panel Grid.Row="1">
                            <ScrollViewer VerticalScrollBarVisibility="Auto" IsVisible="{Binding HasAppUsage}">
                                <ListBox Classes="plain-list"
                                         ItemsSource="{Binding AppUsage}"
                                         SelectedItem="{Binding SelectedAppUsageItem, Mode=TwoWay}"
                                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                         ScrollViewer.VerticalScrollBarVisibility="Disabled">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate x:DataType="vm:AppUsageItemViewModel">
                                            <Border Classes="app-row"
                                                    Padding="16,8"
                                                    BorderBrush="{DynamicResource AppBorderBrush}"
                                                    BorderThickness="0,0,0,1"
                                                    ToolTip.Tip="{Binding DisplayName}">
                                                <Grid ColumnDefinitions="*,140,76,60,60" ColumnSpacing="18">
                                                    <StackPanel Orientation="Horizontal" Spacing="10">
                                                        <Panel Width="16" Height="16" VerticalAlignment="Center">
                                                            <controls:AwayFill Width="16" Height="16" CornerRadius="2"
                                                                               IsVisible="{Binding IsIdle}" />
                                                            <Panel IsVisible="{Binding !IsIdle}">
                                                                <Border Width="16" Height="16" CornerRadius="2"
                                                                        Background="{Binding Color}"
                                                                        IsVisible="{Binding !HasIcon}" />
                                                                <Image Width="16" Height="16"
                                                                       Source="{Binding Icon}"
                                                                       IsVisible="{Binding HasIcon}" />
                                                            </Panel>
                                                        </Panel>
                                                        <TextBlock Text="{Binding DisplayName}"
                                                                   FontSize="13"
                                                                   TextTrimming="CharacterEllipsis"
                                                                   VerticalAlignment="Center" />
                                                    </StackPanel>
                                                    <Grid Grid.Column="1"
                                                          ColumnDefinitions="*,48"
                                                          ColumnSpacing="8"
                                                          VerticalAlignment="Center">
                                                        <Border Height="10" CornerRadius="2" ClipToBounds="True"
                                                                HorizontalAlignment="Stretch">
                                                            <Panel HorizontalAlignment="Left">
                                                                <Border Height="10"
                                                                        Width="{Binding BarWidth}"
                                                                        CornerRadius="2"
                                                                        Background="{Binding Color}"
                                                                        IsVisible="{Binding !IsIdle}" />
                                                                <controls:AwayFill Height="10"
                                                                                   Width="{Binding BarWidth}"
                                                                                   CornerRadius="2"
                                                                                   IsVisible="{Binding IsIdle}" />
                                                            </Panel>
                                                        </Border>
                                                        <TextBlock Grid.Column="1"
                                                                   Text="{Binding PercentageText}"
                                                                   FontSize="12"
                                                                   VerticalAlignment="Center"
                                                                   HorizontalAlignment="Right" />
                                                    </Grid>
                                                    <TextBlock Grid.Column="2"
                                                               Text="{Binding DurationText}"
                                                               FontSize="12"
                                                               FontWeight="SemiBold"
                                                               VerticalAlignment="Center"
                                                               HorizontalAlignment="Right" />
                                                    <TextBlock Grid.Column="3"
                                                               Text="{Binding KeyText}"
                                                               Classes="muted"
                                                               FontSize="12"
                                                               VerticalAlignment="Center"
                                                               HorizontalAlignment="Right" />
                                                    <TextBlock Grid.Column="4"
                                                               Text="{Binding ClickText}"
                                                               Classes="muted"
                                                               FontSize="12"
                                                               VerticalAlignment="Center"
                                                               HorizontalAlignment="Right" />
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </ScrollViewer>
                            <StackPanel Spacing="6"
                                        VerticalAlignment="Center"
                                        HorizontalAlignment="Center"
                                        IsVisible="{Binding !HasAppUsage}">
                                <TextBlock Classes="empty-title" Text="No apps" />
                                <TextBlock Classes="empty-body" Text="Usage breakdown appears once tracking has data." />
                            </StackPanel>
                        </Panel>
                        <Border Grid.Row="2"
                                BorderBrush="{DynamicResource AppBorderBrush}"
                                BorderThickness="0,1,0,0"
                                Padding="16,7"
                                Background="{DynamicResource AppSubtleBrush}">
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                                <StackPanel Orientation="Horizontal" Spacing="15" VerticalAlignment="Center">
                                    <TextBlock Classes="muted" FontSize="13" FontWeight="Medium"
                                               Text="{Binding ActiveDurationText, StringFormat='Active {0}'}"
                                               ToolTip.Tip="Time using apps" />
                                    <TextBlock Classes="muted" FontSize="13" FontWeight="Medium"
                                               Text="{Binding IdleDurationText, StringFormat='Away {0}'}"
                                               ToolTip.Tip="No keyboard or mouse input" />
                                    <TextBlock Classes="muted" FontSize="13" FontWeight="Medium"
                                               Text="{Binding KeyPressCount, StringFormat='Keys {0}'}" />
                                    <TextBlock Classes="muted" FontSize="13" FontWeight="Medium"
                                               Text="{Binding MouseClickCount, StringFormat='Clicks {0}'}" />
                                </StackPanel>
                                <TextBlock Grid.Column="1"
                                           Text="{Binding ScreenTimeText, StringFormat='Tracked {0}'}"
                                           FontSize="15"
                                           FontWeight="SemiBold"
                                           HorizontalAlignment="Right"
                                           VerticalAlignment="Center"
                                           ToolTip.Tip="Active + Away" />
                            </Grid>
                        </Border>
                    </Grid>
                </Border>

                <Border Grid.Column="4" Classes="panel" Padding="0">
                    <Grid RowDefinitions="40,*">
                        <Border BorderBrush="{DynamicResource AppBorderBrush}"
                                BorderThickness="0,0,0,1"
                                Padding="16,0"
                                Background="{DynamicResource AppSurfaceAltBrush}">
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Text="Open" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"
                                           ToolTip.Tip="Apps with a visible window, including unfocused" />
                                <TextBlock Grid.Column="1" Classes="muted" FontSize="11" FontWeight="SemiBold"
                                           Text="Time" VerticalAlignment="Center" />
                            </Grid>
                        </Border>
                        <Panel Grid.Row="1">
                            <ScrollViewer VerticalScrollBarVisibility="Auto" IsVisible="{Binding HasOpenApps}">
                                <ItemsControl ItemsSource="{Binding OpenApps}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:OpenAppItemViewModel">
                                            <Border Classes="app-row"
                                                    Padding="12,8"
                                                    BorderBrush="{DynamicResource AppBorderBrush}"
                                                    BorderThickness="0,0,0,1"
                                                    ToolTip.Tip="{Binding DisplayName}">
                                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                                        <Panel Width="16" Height="16" VerticalAlignment="Center">
                                                            <Border Width="16" Height="16" CornerRadius="2"
                                                                    Background="{Binding Color}"
                                                                    IsVisible="{Binding !HasIcon}" />
                                                            <Image Width="16" Height="16"
                                                                   Source="{Binding Icon}"
                                                                   IsVisible="{Binding HasIcon}" />
                                                        </Panel>
                                                        <TextBlock Text="{Binding DisplayName}"
                                                                   FontSize="13"
                                                                   TextTrimming="CharacterEllipsis"
                                                                   VerticalAlignment="Center" />
                                                    </StackPanel>
                                                    <TextBlock Grid.Column="1"
                                                               Text="{Binding OpenDurationText}"
                                                               FontSize="12"
                                                               FontWeight="SemiBold"
                                                               VerticalAlignment="Center" />
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                            <StackPanel Spacing="6"
                                        VerticalAlignment="Center"
                                        HorizontalAlignment="Center"
                                        IsVisible="{Binding !HasOpenApps}">
                                <TextBlock Classes="empty-title" Text="None open" />
                                <TextBlock Classes="empty-body" Text="Visible windows will appear here." />
                            </StackPanel>
                        </Panel>
                    </Grid>
                </Border>
            </Grid>
        </Grid>

        <!-- Insights -->
        <ScrollViewer Grid.Row="1"
                      Margin="16"
                      IsVisible="{Binding IsInsightsSelected}"
                      VerticalScrollBarVisibility="Auto">
            <StackPanel Spacing="12">
                <Grid ColumnDefinitions="1.35*,*,*,0.9*,0.9*" ColumnSpacing="12">
                    <Border Classes="panel-accent" Padding="18" ToolTip.Tip="Time using apps">
                        <StackPanel Spacing="6">
                            <TextBlock FontSize="12"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource AppAccentBrush}"
                                       Text="Active" />
                            <TextBlock Text="{Binding InsightActiveDurationText}"
                                       FontSize="28"
                                       FontWeight="Bold"
                                       Foreground="{DynamicResource AppTextBrush}" />
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="1" Classes="panel" Padding="18" ToolTip.Tip="Active + Away">
                        <StackPanel Spacing="6">
                            <TextBlock Classes="muted" FontSize="12" Text="Tracked" />
                            <TextBlock Text="{Binding InsightScreenTimeText}" FontSize="22" FontWeight="Bold" />
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="2" Classes="panel" Padding="18" ToolTip.Tip="No keyboard or mouse input">
                        <StackPanel Spacing="6">
                            <TextBlock Classes="muted" FontSize="12" Text="Away" />
                            <TextBlock Text="{Binding InsightIdleDurationText}" FontSize="22" FontWeight="Bold" />
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="3" Classes="panel" Padding="18">
                        <StackPanel Spacing="6">
                            <TextBlock Classes="muted" FontSize="12" Text="Keys" />
                            <TextBlock Text="{Binding InsightKeyPressCount}"
                                       Classes="muted"
                                       FontSize="18"
                                       FontWeight="SemiBold" />
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="4" Classes="panel" Padding="18">
                        <StackPanel Spacing="6">
                            <TextBlock Classes="muted" FontSize="12" Text="Clicks" />
                            <TextBlock Text="{Binding InsightMouseClickCount}"
                                       Classes="muted"
                                       FontSize="18"
                                       FontWeight="SemiBold" />
                        </StackPanel>
                    </Border>
                </Grid>

                <Border Classes="panel" Padding="18">
                    <StackPanel Spacing="10">
                        <Grid ColumnDefinitions="*,Auto,Auto">
                            <TextBlock Text="Daily active"
                                       FontSize="13"
                                       FontWeight="SemiBold"
                                       ToolTip.Tip="Active minutes per day (excludes Away)" />
                            <TextBlock Grid.Column="1"
                                       Classes="muted"
                                       FontSize="12"
                                       Margin="0,0,16,0"
                                       Text="{Binding InsightAvgActiveText, StringFormat='Avg {0}/day'}" />
                            <TextBlock Grid.Column="2" Classes="muted" FontSize="12" Text="{Binding InsightPeakDayText}" />
                        </Grid>
                        <controls:HourlyChart Height="160"
                                              Values="{Binding InsightDailyValues}"
                                              Labels="{Binding InsightDailyLabels}" />
                    </StackPanel>
                </Border>

                <Border Classes="panel" Padding="0">
                    <Grid RowDefinitions="40,*" MinHeight="120">
                        <Border BorderBrush="{DynamicResource AppBorderBrush}"
                                BorderThickness="0,0,0,1"
                                Padding="16,0"
                                Background="{DynamicResource AppSurfaceAltBrush}">
                            <Grid ColumnDefinitions="*,120,80,80,80">
                                <TextBlock Text="Top apps" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1" Classes="muted" FontSize="11" FontWeight="SemiBold"
                                           Text="Share" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="2" Classes="muted" FontSize="11" FontWeight="SemiBold"
                                           Text="Duration" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="3" Classes="muted" FontSize="11" FontWeight="SemiBold"
                                           Text="Keys" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="4" Classes="muted" FontSize="11" FontWeight="SemiBold"
                                           Text="Clicks" HorizontalAlignment="Right" VerticalAlignment="Center" />
                            </Grid>
                        </Border>
                        <Panel Grid.Row="1">
                            <ItemsControl ItemsSource="{Binding InsightAppUsage}" IsVisible="{Binding HasInsightAppUsage}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:AppUsageItemViewModel">
                                        <Border Classes="app-row"
                                                Padding="16,10"
                                                BorderBrush="{DynamicResource AppBorderBrush}"
                                                BorderThickness="0,0,0,1">
                                            <Grid ColumnDefinitions="*,120,80,80,80">
                                                <StackPanel Orientation="Horizontal" Spacing="10">
                                                    <Panel Width="16" Height="16" VerticalAlignment="Center">
                                                        <controls:AwayFill Width="16" Height="16" CornerRadius="2"
                                                                           IsVisible="{Binding IsIdle}" />
                                                        <Panel IsVisible="{Binding !IsIdle}">
                                                            <Border Width="16" Height="16" CornerRadius="2"
                                                                    Background="{Binding Color}"
                                                                    IsVisible="{Binding !HasIcon}" />
                                                            <Image Width="16" Height="16"
                                                                   Source="{Binding Icon}"
                                                                   IsVisible="{Binding HasIcon}" />
                                                        </Panel>
                                                    </Panel>
                                                    <TextBlock Text="{Binding DisplayName}"
                                                               FontSize="13"
                                                               FontWeight="Medium"
                                                               TextTrimming="CharacterEllipsis"
                                                               VerticalAlignment="Center" />
                                                </StackPanel>
                                                <StackPanel Grid.Column="1"
                                                            Orientation="Horizontal"
                                                            Spacing="6"
                                                            HorizontalAlignment="Right"
                                                            VerticalAlignment="Center">
                                                    <Border Height="10"
                                                            Width="{Binding BarWidth}"
                                                            CornerRadius="2"
                                                            Background="{Binding Color}"
                                                            VerticalAlignment="Center"
                                                            IsVisible="{Binding !IsIdle}" />
                                                    <controls:AwayFill Height="10"
                                                                       Width="{Binding BarWidth}"
                                                                       CornerRadius="2"
                                                                       VerticalAlignment="Center"
                                                                       IsVisible="{Binding IsIdle}" />
                                                    <TextBlock Text="{Binding PercentageText}"
                                                               FontSize="12"
                                                               VerticalAlignment="Center" />
                                                </StackPanel>
                                                <TextBlock Grid.Column="2" Text="{Binding DurationText}"
                                                           FontSize="12" FontWeight="SemiBold"
                                                           HorizontalAlignment="Right" VerticalAlignment="Center" />
                                                <TextBlock Grid.Column="3" Text="{Binding KeyText}" Classes="muted"
                                                           FontSize="12" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                                <TextBlock Grid.Column="4" Text="{Binding ClickText}" Classes="muted"
                                                           FontSize="12" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <StackPanel Spacing="6"
                                        Margin="24"
                                        VerticalAlignment="Center"
                                        HorizontalAlignment="Center"
                                        IsVisible="{Binding !HasInsightAppUsage}">
                                <TextBlock Classes="empty-title" Text="No app usage" />
                                <TextBlock Classes="empty-body" Text="Nothing to summarize for this period yet." />
                            </StackPanel>
                        </Panel>
                    </Grid>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- Settings -->
        <ScrollViewer Grid.Row="1"
                      Margin="16"
                      IsVisible="{Binding IsSettingsSelected}"
                      VerticalScrollBarVisibility="Auto">
            <StackPanel Spacing="12" MaxWidth="640">
                <Border Classes="panel" Padding="18">
                    <StackPanel Spacing="14">
                        <TextBlock Text="Appearance" FontSize="13" FontWeight="SemiBold" />
                        <StackPanel Orientation="Horizontal" Spacing="20">
                            <RadioButton GroupName="Appearance"
                                         Content="System"
                                         IsChecked="{Binding Appearance, Converter={StaticResource StringEqualsConverter}, ConverterParameter=system}" />
                            <RadioButton GroupName="Appearance"
                                         Content="Light"
                                         IsChecked="{Binding Appearance, Converter={StaticResource StringEqualsConverter}, ConverterParameter=light}" />
                            <RadioButton GroupName="Appearance"
                                         Content="Dark"
                                         IsChecked="{Binding Appearance, Converter={StaticResource StringEqualsConverter}, ConverterParameter=dark}" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border Classes="panel" Padding="18">
                    <StackPanel Spacing="14">
                        <TextBlock Text="Tracking" FontSize="13" FontWeight="SemiBold" />
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Spacing="2">
                                <TextBlock Text="Track activity" FontSize="13" />
                                <TextBlock Classes="muted" FontSize="11"
                                           Text="Pause to stop recording new activity." />
                            </StackPanel>
                            <ToggleSwitch Grid.Column="1"
                                          OnContent=""
                                          OffContent=""
                                          IsChecked="{Binding TrackingEnabled}" />
                        </Grid>
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Spacing="2">
                                <TextBlock Text="Idle threshold (minutes)" FontSize="13" />
                                <TextBlock Classes="muted" FontSize="11"
                                           Text="Minutes without input before a session is marked Away." />
                            </StackPanel>
                            <NumericUpDown Grid.Column="1"
                                           Minimum="1"
                                           Maximum="240"
                                           Width="130"
                                           FormatString="0"
                                           Value="{Binding IdleThresholdMinutes}" />
                        </Grid>
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Spacing="2">
                                <TextBlock Text="Keep history for (days)" FontSize="13" />
                                <TextBlock Classes="muted" FontSize="11"
                                           Text="0 keeps history forever." />
                            </StackPanel>
                            <NumericUpDown Grid.Column="1"
                                           Minimum="0"
                                           Width="130"
                                           FormatString="0"
                                           Value="{Binding RetentionDays}" />
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Classes="panel" Padding="18">
                    <StackPanel Spacing="14">
                        <TextBlock Text="Startup" FontSize="13" FontWeight="SemiBold" />
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Spacing="2">
                                <TextBlock Text="Start with Windows" FontSize="13" />
                                <TextBlock Classes="muted" FontSize="11"
                                           Text="Launch Daylane automatically when you sign in." />
                            </StackPanel>
                            <ToggleSwitch Grid.Column="1"
                                          OnContent=""
                                          OffContent=""
                                          IsChecked="{Binding AutoStart}" />
                        </Grid>
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Spacing="2">
                                <TextBlock Text="Show window on startup" FontSize="13" />
                                <TextBlock Classes="muted" FontSize="11"
                                           Text="Otherwise Daylane starts minimized to the tray." />
                            </StackPanel>
                            <ToggleSwitch Grid.Column="1"
                                          OnContent=""
                                          OffContent=""
                                          IsChecked="{Binding ShowWindowOnAutoStart}" />
                        </Grid>
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Spacing="2">
                                <TextBlock Text="Minimize to tray" FontSize="13" />
                                <TextBlock Classes="muted" FontSize="11"
                                           Text="Closing the window keeps Daylane running in the tray." />
                            </StackPanel>
                            <ToggleSwitch Grid.Column="1"
                                          OnContent=""
                                          OffContent=""
                                          IsChecked="{Binding MinimizeToTray}" />
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Classes="panel" Padding="18">
                    <StackPanel Spacing="14">
                        <TextBlock Text="Privacy" FontSize="13" FontWeight="SemiBold" />
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Spacing="2">
                                <TextBlock Text="Record window titles" FontSize="13" />
                                <TextBlock Classes="muted" FontSize="11"
                                           Text="Stores each window's title alongside its app. Off by default." />
                            </StackPanel>
                            <ToggleSwitch Grid.Column="1"
                                          OnContent=""
                                          OffContent=""
                                          IsChecked="{Binding RecordWindowTitles}" />
                        </Grid>
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Spacing="2">
                                <TextBlock Text="Record browser site" FontSize="13" />
                                <TextBlock Classes="muted" FontSize="11"
                                           Text="Stores the site's host only, never the full address." />
                            </StackPanel>
                            <ToggleSwitch Grid.Column="1"
                                          OnContent=""
                                          OffContent=""
                                          IsEnabled="{Binding CanRecordBrowserHost}"
                                          IsChecked="{Binding RecordBrowserHost}" />
                        </Grid>

                        <StackPanel Spacing="6">
                            <TextBlock Text="Private keywords" FontSize="13" />
                            <TextBlock Classes="muted" FontSize="11"
                                       Text="A matching title or site means nothing is recorded for that window -- the time still counts." />
                            <ItemsControl ItemsSource="{Binding PrivacyKeywords}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="x:String">
                                        <Grid ColumnDefinitions="*,Auto" Margin="0,4">
                                            <TextBlock Text="{Binding}" FontSize="13" VerticalAlignment="Center" />
                                            <Button Grid.Column="1"
                                                    Classes="secondary"
                                                    Content="Remove"
                                                    Command="{Binding $parent[ItemsControl].((vm:MainWindowViewModel)DataContext).RemovePrivacyKeywordCommand}"
                                                    CommandParameter="{Binding}" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                <TextBox Text="{Binding NewPrivacyKeyword}" PlaceholderText="Keyword" />
                                <Button Grid.Column="1"
                                        Classes="secondary"
                                        Content="Add"
                                        Command="{Binding AddPrivacyKeywordCommand}" />
                            </Grid>
                        </StackPanel>

                        <StackPanel Spacing="6">
                            <TextBlock Text="Ignored windows" FontSize="13" />
                            <TextBlock Classes="muted" FontSize="11"
                                       Text="The time stops counting; remove an entry to start counting it again." />
                            <TextBlock Classes="muted" FontSize="11"
                                       IsVisible="{Binding !CanIgnoreByTitleKeyword}"
                                       TextWrapping="Wrap"
                                       Text="Title keywords need &quot;Record window titles&quot; on. With it off, a rule can only ignore a whole app." />
                            <ItemsControl ItemsSource="{Binding IgnoreRules}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="models:IgnoreRule">
                                        <Grid ColumnDefinitions="*,Auto" Margin="0,4">
                                            <TextBlock Text="{Binding Converter={StaticResource IgnoreRuleDisplayConverter}}"
                                                       FontSize="13"
                                                       VerticalAlignment="Center" />
                                            <Button Grid.Column="1"
                                                    Classes="secondary"
                                                    Content="Remove"
                                                    Command="{Binding $parent[ItemsControl].((vm:MainWindowViewModel)DataContext).RemoveIgnoreRuleCommand}"
                                                    CommandParameter="{Binding}" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <Grid ColumnDefinitions="*,*,Auto" ColumnSpacing="8">
                                <TextBox Text="{Binding NewIgnoreRuleProcess}" PlaceholderText="Process (e.g. chrome)" />
                                <TextBox Grid.Column="1"
                                         Text="{Binding NewIgnoreRuleKeyword}"
                                         IsEnabled="{Binding CanIgnoreByTitleKeyword}"
                                         PlaceholderText="Title keyword (optional)" />
                                <Button Grid.Column="2"
                                        Classes="secondary"
                                        Content="Add"
                                        Command="{Binding AddIgnoreRuleCommand}" />
                            </Grid>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border Classes="panel" Padding="18">
                    <StackPanel Spacing="14">
                        <TextBlock Text="Updates" FontSize="13" FontWeight="SemiBold" />
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Spacing="2">
                                <TextBlock Text="Check for updates" FontSize="13" />
                                <TextBlock Classes="muted" FontSize="11"
                                           TextWrapping="Wrap"
                                           Text="Off by default. When on, Daylane asks GitHub once per launch whether a newer release exists. Nothing else is sent." />
                            </StackPanel>
                            <ToggleSwitch Grid.Column="1"
                                          OnContent=""
                                          OffContent=""
                                          IsChecked="{Binding CheckForUpdates}" />
                        </Grid>
                        <TextBlock Text="{Binding UpdateStatus}" FontSize="13" />
                        <StackPanel Spacing="6">
                            <Button Classes="secondary"
                                    Content="Check now"
                                    Command="{Binding CheckForUpdatesCommand}" />
                            <TextBlock Classes="muted" FontSize="11"
                                       Text="Checks once, even when the switch is off." />
                        </StackPanel>
                        <Button Classes="secondary"
                                Content="Download"
                                Command="{Binding OpenUpdateLinkCommand}"
                                IsVisible="{Binding HasUpdateLink}" />
                    </StackPanel>
                </Border>

                <Border Classes="panel" Padding="18">
                    <StackPanel Spacing="14">
                        <TextBlock Text="Data" FontSize="13" FontWeight="SemiBold" />
                        <StackPanel Spacing="2">
                            <TextBlock Text="{Binding StorageSummary}" FontSize="13" />
                            <TextBlock Text="{Binding RecordedRowsSummary}" FontSize="13" />
                        </StackPanel>
                        <StackPanel Spacing="6">
                            <TextBlock Text="{Binding DatabasePathDisplay}" FontSize="13" TextWrapping="Wrap" />
                            <Button Classes="secondary"
                                    Content="Open folder"
                                    Command="{Binding OpenDataFolderCommand}" />
                        </StackPanel>
                        <TextBlock Classes="muted" FontSize="11"
                                   TextWrapping="Wrap"
                                   Text="Daylane prunes automatically when a retention window is set, and keeps everything when it is not." />
                        <Button Classes="secondary"
                                Content="Delete recorded activity"
                                Command="{Binding PurgeDataCommand}" />
                        <StackPanel Spacing="8" IsVisible="{Binding ConfirmPurgeVisible}">
                            <TextBlock FontSize="13"
                                       TextWrapping="Wrap"
                                       Text="This permanently deletes all recorded activity on this computer. It cannot be undone. Your settings are kept." />
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Button Classes="secondary"
                                        Content="Delete everything"
                                        Command="{Binding ConfirmPurgeCommand}" />
                                <Button Classes="secondary"
                                        Content="Cancel"
                                        Command="{Binding CancelPurgeCommand}" />
                            </StackPanel>
                        </StackPanel>
                        <TextBlock Classes="muted" FontSize="11"
                                   TextWrapping="Wrap"
                                   IsVisible="{Binding PurgeResultSummary}"
                                   Text="{Binding PurgeResultSummary}" />
                    </StackPanel>
                </Border>

                <Border Classes="panel" Padding="18">
                    <StackPanel Spacing="14">
                        <TextBlock Text="About" FontSize="13" FontWeight="SemiBold" />
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Text="Version" FontSize="13" />
                            <TextBlock Grid.Column="1" Text="{Binding AppVersion}" FontSize="13" />
                        </Grid>
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Text="Author" FontSize="13" />
                            <TextBlock Grid.Column="1" Text="{Binding AppAuthor}" FontSize="13" />
                        </Grid>
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Text="License" FontSize="13" />
                            <TextBlock Grid.Column="1" Text="{Binding AppLicense}" FontSize="13" />
                        </Grid>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button Classes="secondary"
                                    Content="Repository"
                                    Command="{Binding OpenRepositoryCommand}" />
                            <Button Classes="secondary"
                                    Content="Report an issue"
                                    Command="{Binding OpenIssuesCommand}" />
                            <Button Classes="secondary"
                                    Content="License"
                                    Command="{Binding OpenLicenseCommand}" />
                        </StackPanel>
                        <StackPanel Spacing="2">
                            <TextBlock Classes="muted" FontSize="11"
                                       TextWrapping="Wrap"
                                       Text="Daylane's feature set follows Hindsight, the project this is a port of." />
                            <Button Classes="secondary"
                                    Content="View Hindsight"
                                    Command="{Binding OpenUpstreamProjectCommand}" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
